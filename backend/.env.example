# Copy to .env on the server and fill in real values. .env itself is
# gitignored and must never be committed.
#
# The two JWT secrets are deliberately separate: a company token and an
# admin token are signed with different keys, so a leak of one cannot be
# used to mint the other.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chekino_db
JWT_SECRET=
ADMIN_JWT_SECRET=
PORT=3000
